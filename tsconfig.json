{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    "strict": true,
    "noImplicitAny": true,
    "skipLibCheck": true
  },
  "include": [
    "App.tsx",
    "src",
    "nativewind-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "Pods"
  ]
}
